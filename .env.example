# Copy to .env (git-ignored). Never commit real values.
DATABASE_URL=postgresql+psycopg://qco:qco@localhost:5432/qco
DATA_DIR=./data            # /data inside Docker

# Fetching
USER_AGENT=QCOWatch/0.1 (+contact: you@example.com)
MIN_REQUEST_INTERVAL_S=2.0
LISTING_TTL_HOURS=12
ANAKIN_API_KEY=
ANAKIN_MAX_CREDITS=50      # hard stop; requests that could exceed this are refused

# LLM (Phase 2)
LLM_PROVIDER=              # anthropic | openai (openai also = any OpenAI-compatible endpoint via LLM_BASE_URL)
LLM_API_KEY=
LLM_MODEL=                 # use the strongest model available for extraction + HS rerank
LLM_BASE_URL=              # OpenAI-compatible endpoint, e.g. Gemini: https://generativelanguage.googleapis.com/v1beta/openai (then LLM_PROVIDER=openai)
LLM_JSON_MODE=json_schema  # or json_object if the endpoint rejects json_schema
EMBED_PROVIDER=            # blank = local fastembed (BAAI/bge-small-en-v1.5), or openai
EMBED_MODEL=

# Email (Phase 3)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
